{
  "name": "labprompter",
  "productName": "LabPrompter",
  "version": "1.5.0",
  "description": "Local-only teleprompter for the Elgato Prompter XL with an operator-visible reading line and Contour shuttle control.",
  "private": true,
  "license": "MIT",
  "author": "Aaron Abernethy",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "build:helper": "node tools/build-speech-helper.js",
    "dist": "npm run build:helper && electron-builder",
    "release": "npm run build:helper && electron-builder --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.8.0",
    "node-hid": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.labprompter.app",
    "productName": "LabPrompter",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        { "from": "native/speech-helper/dist/speech-helper", "to": "speech-helper" }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LabPrompter uses the microphone so voice-follow can keep the script scrolling in time with your voice. Audio is processed on this Mac only.",
        "NSSpeechRecognitionUsageDescription": "LabPrompter uses on-device speech recognition to match your voice to the script for voice-follow scrolling. Nothing is sent to Apple or anywhere else."
      }
    },
    "publish": {
      "provider": "github",
      "owner": "aaronabernethy",
      "repo": "labprompter"
    }
  }
}
