{
  "name": "labprompter",
  "productName": "LabPrompter",
  "version": "1.5.0",
  "description": "Local-only teleprompter for the Elgato Prompter XL with an operator-visible reading line and Contour shuttle control.",
  "private": true,
  "license": "MIT",
  "author": "Aaron Abernethy",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:helper && electron .",
    "smoke": "electron . --smoke-test",
    "build:helper": "node tools/build-speech-helper.js",
    "dist": "npm run build:helper && electron-builder",
    "release": "npm run build:helper && electron-builder --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.8.0",
    "node-hid": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
